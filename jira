#!/usr/bin/env bash
# jira - small JIRA CLI.
#
# Subcommands:
#   jira news     Lists my JIRA tasks (open, or in current sprint) as an Obsidian-pastable markdown list (incl. hours: spent / estimate).
#   jira verify [--sprint ID]  For JIRA_EMAIL, picks an active/future sprint via fzf, flags sprint/estimate hygiene issues and reports sprint hour totals.
#   jira sprint   Prints the current and future sprints of JIRA_BOARD_ID.
#   jira burndown `jira burndown [--user EMAIL] [--sprint SPRINT_ID]` prints an ASCII burndown
#                 chart (hours) for a user's issues in a sprint. Omit --sprint to pick from active or
#                 future sprints via fzf; omit --user to default to JIRA_EMAIL.
#   jira release  Lists unreleased versions (and the last released one) of JIRA_PROJECT, or `jira release <PROJECT>`.
#   jira update   `jira update TASK_ID STATUS` transitions an issue. STATUS is one of:
#                 todo, inprogress, review, done, closed.
#
# Required env vars (set them in a non-tracked file, e.g. ~/.zshrc.local; checked per command by require_config):
#   JIRA_BASE_URL    e.g. https://your-org.atlassian.net
#   JIRA_EMAIL       your Atlassian login email
#   JIRA_API_TOKEN   https://id.atlassian.com/manage-profile/security/api-tokens
#   JIRA_BOARD_ID    the Agile board id to inspect (required by `jira sprint` and `jira verify`).
#                    Find it via: GET $JIRA_BASE_URL/rest/agile/1.0/board?projectKeyOrId=<PROJECT>
# Required by `jira update` (transition IDs; find via GET $API/issue/<KEY>/transitions):
#   JIRA_TRANSITION_TODO        e.g. 51 (To Do)
#   JIRA_TRANSITION_INPROGRESS  e.g. 31 (In Progress)
#   JIRA_TRANSITION_REVIEW      e.g. 3  (In Review)
#   JIRA_TRANSITION_DONE        e.g. 41 (Done)
#   JIRA_TRANSITION_CLOSED      e.g. 41 (Closed, if distinct from Done on your workflow)
# Optional:
#   JIRA_ACCOUNT_ID  your Atlassian accountId (required by `jira news`)
#   JIRA_SPRINT_FIELD  Jira custom field id holding sprints (default customfield_10018)
#   JIRA_PROJECT     default project key for `jira release` (e.g. PROJ); can be overridden with `jira release <PROJECT>`
#   JIRA_VERIFY_SINCE_DAYS  how far back `jira verify` looks for non-Done issues (default 90)
#   JIRA_VERIFY_DONE_DAYS   how far back `jira verify` looks for Done/Closed issues, measured from when they entered Done (default 14)

set -euo pipefail

# --- Config module ------------------------------------------------------------
# Interface: require_config COMMAND
#   Checks the environment COMMAND needs, exits with a hint when something is missing, and
#   sets AUTH, API, AGILE_API and JIRA_SPRINT_FIELD. Commands read config; they never check it.
config_extra_vars() {  # extra variables needed by a command, beyond the always-required ones
  case "$1" in
    news) echo "JIRA_ACCOUNT_ID" ;;
    verify|sprint|burndown) echo "JIRA_BOARD_ID" ;;
  esac
}

config_hint() {
  case "$1" in
    JIRA_BASE_URL)   echo "e.g. https://your-org.atlassian.net" ;;
    JIRA_API_TOKEN)  echo "https://id.atlassian.com/manage-profile/security/api-tokens" ;;
    JIRA_ACCOUNT_ID) echo "your Atlassian accountId" ;;
    JIRA_BOARD_ID)   echo "see GET \$JIRA_BASE_URL/rest/agile/1.0/board?projectKeyOrId=<PROJECT>" ;;
  esac
}

require_config() {
  local var hint
  for var in JIRA_BASE_URL JIRA_EMAIL JIRA_API_TOKEN $(config_extra_vars "$1"); do
    if [ -z "${!var:-}" ]; then
      hint=$(config_hint "$var")
      echo "Set $var${hint:+ ($hint)}" >&2
      exit 1
    fi
  done
  command -v jq >/dev/null || { echo "jq required" >&2; exit 1; }

  JIRA_SPRINT_FIELD="${JIRA_SPRINT_FIELD:-customfield_10018}"
  AUTH="${JIRA_EMAIL}:${JIRA_API_TOKEN}"
  API="${JIRA_BASE_URL%/}/rest/api/3"
  AGILE_API="${JIRA_BASE_URL%/}/rest/agile/1.0"
}

# Interactive only when stdin and stdout are terminals (checked here: command substitutions hide stdout).
IS_TTY=0; [ -t 0 ] && [ -t 1 ] && IS_TTY=1

api_get() {
  local out curl_exit http_code body
  set +e
  out=$(curl -s -w '\n%{http_code}' -u "$AUTH" -H "Accept: application/json" "$@")
  curl_exit=$?
  set -e

  if [ $curl_exit -ne 0 ]; then
    echo "curl failed (exit $curl_exit) calling: $API..." >&2
    case $curl_exit in
      56) echo "  = failed receiving data. Usually corporate proxy/VPN/TLS interception. Try: check VPN, or set https_proxy/HTTPS_PROXY env, or curl -v to same URL to see where it dies." >&2 ;;
      6)  echo "  = could not resolve host. Check JIRA_BASE_URL." >&2 ;;
      28) echo "  = timeout. Check network/VPN." >&2 ;;
      60) echo "  = SSL cert problem. Corporate proxy doing TLS inspection? Check its CA cert is trusted." >&2 ;;
    esac
    exit 1
  fi

  http_code=$(echo "$out" | tail -n1)
  body=$(echo "$out" | sed '$d')

  if [ "$http_code" -ge 400 ]; then
    echo "JIRA API returned HTTP $http_code" >&2
    echo "$body" | jq . >&2 2>/dev/null || echo "$body" >&2
    case $http_code in
      401) echo "  = JIRA_API_TOKEN is missing, wrong, or expired." >&2
           echo "  1. Generate a new token: https://id.atlassian.com/manage-profile/security/api-tokens" >&2
           echo "  2. Update JIRA_API_TOKEN in ~/.zshrc.local" >&2
           echo "  3. Run: source ~/.zshrc.local && jira news" >&2 ;;
      403) echo "  = no permission, or hit CAPTCHA lockout (too many bad auth attempts) - login via browser once." >&2 ;;
    esac
    exit 1
  fi

  echo "$body"
}

# POST JSON to a JIRA endpoint. Usage: api_post <url> <json-body>
api_post() {
  local url="$1" json="$2"
  local out curl_exit http_code body
  set +e
  out=$(curl -s -w '\n%{http_code}' -u "$AUTH" -X POST \
    -H "Accept: application/json" -H "Content-Type: application/json" \
    --data "$json" "$url")
  curl_exit=$?
  set -e

  if [ $curl_exit -ne 0 ]; then
    echo "curl failed (exit $curl_exit) calling: $url" >&2
    exit 1
  fi

  http_code=$(echo "$out" | tail -n1)
  body=$(echo "$out" | sed '$d')

  if [ "$http_code" -ge 400 ]; then
    echo "JIRA API returned HTTP $http_code" >&2
    echo "$body" | jq . >&2 2>/dev/null || echo "$body" >&2
    exit 1
  fi

  echo "$body"
}

# Verify auth explicitly: /search/jql can silently return 0 issues on an
# expired/invalid token instead of a 401, which used to look like "no work to do".
verify_auth() {
  api_get "$API/myself" >/dev/null
}

# Fetch all issues matching a JQL (cursor pagination) as one JSON array.
# Usage: fetch_issues JQL FIELDS [EXPAND]   e.g. fetch_issues "$jql" "summary,status" changelog
# Each element is the issue as returned by /search/jql: {key, fields: {FIELDS...}, changelog?}.
fetch_issues() {
  local jql="$1" fields="$2" expand="${3:-}"
  local -a args
  local lines="" next_token="" page_size=100 resp is_last

  while :; do
    args=(-G "$API/search/jql" \
      --data-urlencode "jql=$jql" \
      --data-urlencode "fields=$fields" \
      --data-urlencode "maxResults=$page_size")
    [ -n "$expand" ] && args+=(--data-urlencode "expand=$expand")
    [ -n "$next_token" ] && args+=(--data-urlencode "nextPageToken=$next_token")

    resp=$(api_get "${args[@]}")
    lines+=$(echo "$resp" | jq -c '.issues[]')$'\n'

    is_last=$(echo "$resp" | jq -r 'if .isLast == false then "false" else "true" end')
    [ "$is_last" = "true" ] && break
    next_token=$(echo "$resp" | jq -r '.nextPageToken // empty')
    [ -z "$next_token" ] && break
  done

  printf '%s' "$lines" | jq -s -c '.'
}

# Fetch all sprints of a board in a given state (active|future|closed), via offset pagination.
fetch_board_sprints() {
  local board_id="$1" state="$2"
  local all="[]" start_at=0 page_size=50 resp values is_last

  while :; do
    resp=$(api_get -G "$AGILE_API/board/$board_id/sprint" \
      --data-urlencode "state=$state" \
      --data-urlencode "startAt=$start_at" \
      --data-urlencode "maxResults=$page_size")
    values=$(echo "$resp" | jq -c '.values')
    all=$(jq -c -n --argjson a "$all" --argjson b "$values" '$a + $b')
    is_last=$(echo "$resp" | jq -r 'if .isLast == false then "false" else "true" end')
    [ "$is_last" = "true" ] && break
    start_at=$((start_at + page_size))
  done

  echo "$all"
}

# --- Sprint module -----------------------------------------------------------
# Interface (all take JIRA_BOARD_ID from the environment, print JSON):
#   list_open_sprints          active sprints first, then future sprints by start date
#   pick_sprint [SPRINT_ID]    JSON array of the sprint(s) to report on:
#                                SPRINT_ID given  -> that sprint
#                                terminal + fzf   -> the sprint chosen in fzf
#                                otherwise        -> all active sprints
#   previous_sprint TARGETS    sprint that started latest before the earliest of TARGETS
#                              (closed, or active when a future sprint is targeted); empty if none
list_open_sprints() {
  fetch_board_sprints "$JIRA_BOARD_ID" "active,future" \
    | jq -c 'sort_by([(if .state == "active" then 0 else 1 end), (.startDate // "9999")])'
}

pick_sprint() {
  local sprint_id="${1:-}" open picked=""
  if [ -n "$sprint_id" ]; then
    api_get "$AGILE_API/sprint/$sprint_id" | jq -c '[.]'
    return
  fi
  open=$(list_open_sprints)
  if [ "$IS_TTY" = 1 ] && command -v fzf >/dev/null && [ "$(echo "$open" | jq 'length')" -gt 0 ]; then
    picked=$(echo "$open" \
      | jq -r '.[] | "\(.id)\t[\(.state)] \(.name) (\((.startDate // "?")[0:10]) → \((.endDate // "?")[0:10]))"' \
      | fzf --with-nth=2 --delimiter='\t' --prompt="Sprint> ") || true
    [ -z "$picked" ] && { echo "No sprint selected." >&2; exit 1; }
    echo "$open" | jq -c --argjson id "$(printf '%s' "$picked" | cut -f1)" '[.[] | select(.id == $id)]'
  else
    echo "$open" | jq -c '[.[] | select(.state == "active")]'
  fi
}

previous_sprint() {
  local targets="$1"
  fetch_board_sprints "$JIRA_BOARD_ID" "active,closed" \
    | jq -c --argjson t "$targets" '
        ($t | map(.startDate // "") | min // "") as $ts
        | ($t | map(.id)) as $tids
        | map(select(.id as $i | $tids | index($i) | not))
        | map(select(($ts == "") or ((.startDate // "") != "" and .startDate < $ts)))
        | sort_by(.startDate // "") | reverse
        | first // empty'
}

cmd_news() {
  verify_auth

  local jql='assignee = currentUser() AND (statusCategory != Done OR sprint in openSprints()) ORDER BY updated DESC'
  local issues
  issues=$(fetch_issues "$jql" "summary,status,${JIRA_SPRINT_FIELD},comment,issuelinks,timeoriginalestimate,timespent" changelog)

  if [ "$(echo "$issues" | jq 'length')" -eq 0 ]; then
    echo "No issues found." >&2
    exit 0
  fi

  # One row per issue. Hours: original estimate and time spent (seconds -> hours), "" when unset.
  # Parent: "Parent-Child" issue link type (id 10206): outwardIssue = "is parent of" us.
  # last: newest description edit or comment by someone other than me.
  local rows
  rows=$(echo "$issues" | jq -c --arg sf "$JIRA_SPRINT_FIELD" --arg me "$JIRA_ACCOUNT_ID" --arg base "$JIRA_BASE_URL" '
    def h: if . == null then "-" else ((. / 360 | round) / 10 | tostring) end;
    map({
      key: .key,
      status: .fields.status.name,
      sprint: ((.fields[$sf] // []) as $sprints
        | ($sprints | map(select(.state == "active"))) as $active
        | if ($active | length) > 0 then $active[0].name else ($sprints[-1].name // "") end),
      summary: .fields.summary,
      last: (([.changelog.histories[]?
                | select(.author.accountId != $me)
                | select(any(.items[]?; .field == "description"))
                | .created]
              + [.fields.comment.comments[]?
                  | select(.author.accountId != $me)
                  | (.updated // .created)])
             | sort | last // ""),
      base: $base,
      parent: ([.fields.issuelinks[]? | select(.type.id == "10206") | .outwardIssue.key] | first // ""),
      hours: (if (.fields.timeoriginalestimate == null and .fields.timespent == null) then ""
              else "\(.fields.timespent // 0 | h)h / \(.fields.timeoriginalestimate | h)h" end)
    })')

  # Sort: status group first (Done, In Review, In Progress, To Do, other), then newest last_change within group
  local status_rank='{"Done":0,"In Review":1,"In Progress":2,"To Do":3}'
  local sorted
  sorted=$(echo "$rows" | jq --argjson rank "$status_rank" '
    map(. + {_rank: ($rank[.status] // 4)})
    | group_by(._rank)
    | sort_by(.[0]._rank)
    | map(sort_by(.last) | reverse)
    | flatten
    | map(del(._rank))
  ')

  esc() { printf '%s' "$1" | sed 's/|/\\|/g'; }

  print_row() {
    local row="$1" depth="$2" key base status sprint summary last indent parent_note hours
    key=$(echo "$row" | jq -r '.key')
    base=$(echo "$row" | jq -r '.base')
    status=$(echo "$row" | jq -r '.status')
    sprint=$(echo "$row" | jq -r '.sprint')
    summary=$(echo "$row" | jq -r '.summary')
    last=$(echo "$row" | jq -r '.last')
    parent=$(echo "$row" | jq -r '.parent')
    hours=$(echo "$row" | jq -r '.hours')
    [ -n "$last" ] && last=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${last:0:19}" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$last")
    indent=$(printf '%*s' $((depth * 2)) '')
    parent_note=""
    if [ "$depth" -eq 0 ] && [ -n "$parent" ]; then
      parent_note=" _(parent: [$parent]($base/browse/$parent), not in this list)_"
    fi
    printf "%s- [%s](%s/browse/%s) — %s | %s | %s | %s | %s%s\n" \
      "$indent" "$key" "$base" "$key" "$(esc "$status")" "$(esc "$sprint")" "$(esc "$summary")" "$last" "$hours" "$parent_note"
  }

  # Recursively print a node and its children (children = rows whose .parent == this key).
  print_tree() {
    local key="$1" depth="$2"
    visited="$visited $key"
    local row
    row=$(echo "$sorted" | jq -c --arg k "$key" '.[] | select(.key == $k)')
    print_row "$row" "$depth"
    local children
    children=$(echo "$sorted" | jq -r --arg k "$key" '[.[] | select(.parent == $k) | .key] | .[]')
    local child
    while IFS= read -r child; do
      [ -z "$child" ] && continue
      print_tree "$child" $((depth + 1))
    done <<< "$children"
  }

  # Roots: issues whose parent is empty, or whose parent isn't among the fetched issues.
  local roots
  roots=$(echo "$sorted" | jq -r --argjson present "$(echo "$sorted" | jq '[.[].key]')" '
    [.[] | select((.parent == "") or ((.parent as $p | $present | index($p)) | not)) | .key] | .[]
  ')

  visited=""
  while IFS= read -r root; do
    [ -z "$root" ] && continue
    print_tree "$root" 0
  done <<< "$roots"
}

# Resolve JIRA_EMAIL to an accountId.
resolve_user_account_id() {
  local user="$1"
  if [[ "$user" == *:* ]]; then
    # Already looks like an accountId (contains a colon, e.g. "712020:uuid").
    echo "$user"
    return
  fi
  local resp account_id
  resp=$(api_get -G "$API/user/search" --data-urlencode "query=$user")
  account_id=$(echo "$resp" | jq -r '.[0].accountId // empty')
  if [ -z "$account_id" ]; then
    echo "Could not resolve JIRA_EMAIL='$user' to an accountId via $API/user/search" >&2
    exit 1
  fi
  echo "$account_id"
}

# --- Verify report module -----------------------------------------------------
# Interface: verify_report < input.json   (prints the report; no API calls)
# input: {display_name, account_id, project_prefix,
#         issues:   [{key, base, summary, status, estimate_seconds, sprints:[{id,...}]}],
#         targets:  [sprint],        selected sprints
#         previous: sprint | null}   sprint before the earliest target
# Sprint identity comes from the board (targets/previous), not from whichever sprints happen
# to be attached to this user's own issues.
verify_report() {
  jq -r '
    .issues as $issues | .targets as $targets | .previous as $prev
    | .display_name as $name | .project_prefix as $pp
    | def link: "- [\(.key)](\(.base)/browse/\(.key)) \u2014 \(.status) | \(.summary)";
      def in_sprint($sid): (.sprints // []) | any(.id == $sid);
      def hours($sid): ([$issues[] | select(in_sprint($sid)) | (.estimate_seconds // 0)] | add // 0) / 3600;
      def section: if length == 0 then "(none)" else join("\n") end;
    "=== jira verify: \($name) (\(.account_id)) ===",
    "",
    "-- In progress/review/done with NO sprint --",
    ([$issues[] | select(.status == "In Progress" or .status == "In Review" or .status == "Done")
                | select((.sprints // []) | length == 0) | link] | section),
    "",
    "-- Assigned, in selected sprint, with NO hour estimate --",
    ([$issues[] | select(.estimate_seconds == null)
                | select((.sprints // []) | any(.id as $i | $targets | any(.id == $i))) | link] | section),
    "",
    "-- Sprint hour estimates --",
    (if ($targets | length) == 0 then "Selected sprint: none found."
     else $targets[] | . as $s
       | "Sprint \"\($s.name)\" (\($s.state)): \(hours($s.id))h estimated",
         ([$issues[] | select(in_sprint($s.id)) | select(.key | startswith($pp)) | select(.estimate_seconds != null)]
          | sort_by(.key) | .[] | "  - \(.key): \(.estimate_seconds / 3600)h \u2014 \(.summary)")
     end),
    (if $prev == null then "Previous sprint: none found."
     else "Previous sprint \"\($prev.name)\": \(hours($prev.id))h estimated" end),
    "",
    ([$issues[] | select(.status == "In Progress")] | length) as $n
    | if $n == 0 then "\u26a0 No task is currently In Progress for \($name)."
      else "OK: \($n) task(s) In Progress." end
  '
}

cmd_verify() {
  verify_auth

  local sprint_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --sprint) sprint_id="${2:?--sprint requires a value}"; shift 2 ;;
      *) echo "Unknown argument: $1" >&2; echo "Usage: jira verify [--sprint SPRINT_ID]" >&2; exit 1 ;;
    esac
  done

  # Pick the sprint to report on before the slow issue fetch.
  local target_sprints
  target_sprints=$(pick_sprint "$sprint_id")

  local account_id display_name
  account_id=$(resolve_user_account_id "$JIRA_EMAIL")

  local since_days="${JIRA_VERIFY_SINCE_DAYS:-90}"
  local done_days="${JIRA_VERIFY_DONE_DAYS:-14}"
  local jql="assignee = \"$account_id\" AND ((statusCategory != Done AND updated >= -${since_days}d) OR (statusCategory = Done AND statusCategoryChangedDate >= -${done_days}d)) ORDER BY updated DESC"
  local issues
  issues=$(fetch_issues "$jql" "summary,status,${JIRA_SPRINT_FIELD},timeoriginalestimate" \
    | jq -c --arg base "$JIRA_BASE_URL" --arg sf "$JIRA_SPRINT_FIELD" '
        map({key: .key, base: $base, summary: .fields.summary, status: .fields.status.name,
             estimate_seconds: .fields.timeoriginalestimate, sprints: (.fields[$sf] // [])})')

  if [ "$(echo "$issues" | jq 'length')" -eq 0 ]; then
    echo "No issues found for JIRA_EMAIL='$JIRA_EMAIL' (accountId=$account_id)." >&2
    exit 0
  fi

  display_name=$(api_get -G "$API/user" --data-urlencode "accountId=$account_id" | jq -r '.displayName // "'"$JIRA_EMAIL"'"')

  local prev_sprint
  prev_sprint=$(previous_sprint "$target_sprints")

  jq -n --arg name "$display_name" --arg id "$account_id" --arg pp "${JIRA_PROJECT:+$JIRA_PROJECT-}" \
      --argjson issues "$issues" --argjson targets "$target_sprints" --argjson previous "${prev_sprint:-null}" \
      '{display_name: $name, account_id: $id, project_prefix: $pp, issues: $issues, targets: $targets, previous: $previous}' \
    | verify_report
}

cmd_sprint() {
  verify_auth

  local open state label
  open=$(list_open_sprints)

  fmt_sprints() {
    jq -r '.[] | "  - \(.name) (id \(.id), \((.startDate // "?")[0:10]) → \((.endDate // "?")[0:10]))"'
  }

  for state in active future; do
    label="Current"; [ "$state" = future ] && label="Future"
    echo "$label:"
    if [ "$(echo "$open" | jq --arg s "$state" '[.[] | select(.state == $s)] | length')" -eq 0 ]; then
      [ "$state" = active ] && echo "  none (board is between sprints)" || echo "  none"
    else
      echo "$open" | jq -c --arg s "$state" '[.[] | select(.state == $s)]' | fmt_sprints
    fi
  done
}

# --- Burndown series module ---------------------------------------------------
# Interface: burndown_series < input.json   (prints the series as a JSON array; pure, no API calls)
# input:  {issues: [{hours, done_date "YYYY-MM-DD" or ""}], start, end "YYYY-MM-DD", state, today}
# output: [{date, label, ideal, actual}], first a virtual "start" point at 100%, then one point per
#         calendar day of the sprint holding the *end-of-day* value, so day 1 drops from 100% to ~90%.
#         ideal falls linearly over the sprint's Mon-Fri days. actual counts issues done on or before
#         that day; it is null after today (active sprint) or for every day of a future sprint.
burndown_series() {
  jq -c '
    def epoch: . + "T00:00:00Z" | fromdateiso8601;
    def workday: gmtime[6] as $wd | $wd >= 1 and $wd <= 5;   # gmtime weekday: 0 = Sunday
    def r2: . * 100 | round / 100;
    .issues as $issues
    | ([$issues[].hours] | add // 0) as $total
    | [range(.start | epoch; (.end | epoch) + 1; 86400)] as $days
    | ([$days[] | select(workday)] | length | if . == 0 then 1 else . end) as $wdays
    | (if .state == "future" then ""
       elif .state == "active" and .today < .end then .today
       else .end end) as $last_actual_day
    | [{date: "start", label: "start", ideal: $total, actual: $total}]
      + [foreach $days[] as $t (0; . + ($t | if workday then 1 else 0 end); [$t, .])
         | . as [$t, $elapsed]
         | ($t | strftime("%Y-%m-%d")) as $d
         | {date: $d, label: $d[5:],
            ideal: ($total * (1 - $elapsed / $wdays) | r2),
            actual: (if $d > $last_actual_day then null
                     else $total - ([$issues[] | select(.done_date != "" and .done_date <= $d) | .hours] | add // 0) | r2
                     end)}]'
}

cmd_burndown() {
  verify_auth

  local user="$JIRA_EMAIL" sprint_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --user) user="${2:?--user requires a value}"; shift 2 ;;
      --sprint) sprint_id="${2:?--sprint requires a value}"; shift 2 ;;
      *) echo "Unknown argument: $1" >&2; echo "Usage: jira burndown [--user EMAIL] [--sprint SPRINT_ID]" >&2; exit 1 ;;
    esac
  done

  local account_id display_name
  account_id=$(resolve_user_account_id "$user")
  display_name=$(api_get -G "$API/user" --data-urlencode "accountId=$account_id" | jq -r --arg u "$user" '.displayName // $u')

  local picked sprint
  picked=$(pick_sprint "$sprint_id")
  if [ "$(echo "$picked" | jq 'length')" -ne 1 ]; then
    echo "Could not select a single sprint. Run in a terminal with fzf, or pass --sprint SPRINT_ID (required for closed sprints)." >&2
    exit 1
  fi
  sprint=$(echo "$picked" | jq -c '.[0]')
  sprint_id=$(echo "$sprint" | jq -r '.id')

  local sprint_name sprint_state sprint_start sprint_end
  sprint_name=$(echo "$sprint" | jq -r '.name')
  sprint_state=$(echo "$sprint" | jq -r '.state')
  sprint_start=$(echo "$sprint" | jq -r '(.startDate // empty)[0:10]')
  sprint_end=$(echo "$sprint" | jq -r '(.endDate // empty)[0:10]')

  if [ -z "$sprint_start" ] || [ -z "$sprint_end" ]; then
    echo "Sprint $sprint_id has no start/end date set; cannot draw a burndown." >&2
    exit 1
  fi

  local jql="assignee = \"$account_id\" AND sprint = $sprint_id"
  # hours: estimate in hours. done_date: when the issue last moved to Done/Closed, but only
  # while it is *currently* Done/Closed (a reopened issue has not burned down).
  local issues
  issues=$(fetch_issues "$jql" "summary,status,timeoriginalestimate" changelog | jq -c '
    map(.fields.status.name as $status | {
      key: .key,
      summary: .fields.summary,
      status: $status,
      hours: ((.fields.timeoriginalestimate // 0) / 3600),
      done_date: (if $status == "Done" or $status == "Closed" then
          ([.changelog.histories[]?
             | select(any(.items[]?; .field == "status" and (.toString == "Done" or .toString == "Closed")))
             | .created] | sort | last // "" | .[0:10])
        else "" end)
    })')

  if [ "$(echo "$issues" | jq 'length')" -eq 0 ]; then
    echo "No issues assigned to $display_name in sprint \"$sprint_name\"." >&2
    exit 0
  fi

  local total_hours
  total_hours=$(echo "$issues" | jq '[.[].hours] | add')

  local today series
  today=$(date +%Y-%m-%d)
  series=$(jq -n --argjson issues "$issues" --arg start "$sprint_start" --arg end "$sprint_end" \
      --arg state "$sprint_state" --arg today "$today" \
      '{issues: $issues, start: $start, end: $end, state: $state, today: $today}' \
    | burndown_series)

  echo "=== Burndown: $display_name — \"$sprint_name\" ($sprint_start → $sprint_end) ==="
  echo

  command -v uvx >/dev/null || { echo "uvx (from 'uv') is required to render the chart." >&2; exit 1; }

  BURNDOWN_SERIES="$series" \
  BURNDOWN_TITLE="Burndown: $display_name — $sprint_name" \
  BURNDOWN_MAX="$total_hours" \
  BURNDOWN_TODAY="$today" \
  uvx --quiet --from 'plotext==5.2.8' python3 - <<'PY'
import json, os
import plotext as plt

data = json.loads(os.environ["BURNDOWN_SERIES"])
title = os.environ["BURNDOWN_TITLE"]
total = float(os.environ["BURNDOWN_MAX"])
today = os.environ["BURNDOWN_TODAY"]

dates = [d["label"] for d in data]
ideal = [d["ideal"] for d in data]
x = list(range(len(dates)))
x_actual = [i for i, d in enumerate(data) if d["actual"] is not None]
actual = [data[i]["actual"] for i in x_actual]

width = min(100, max(40, len(x) * 6))
plt.plotsize(width, 20)
plt.theme("clear")
plt.plot(x, ideal, label="ideal", color="gray")
if actual:
    plt.plot(x_actual, actual, label="actual", color="red")
today_idx = next((i for i, d in enumerate(data) if d["date"] == today), None)
if today_idx is not None:
    plt.vline(today_idx, color="blue")
plt.xticks(x, dates)
plt.title(title)
plt.xlabel("date")
plt.ylabel("hours remaining")
plt.ylim(0, max(total, max(ideal + actual)) * 1.05 if total > 0 else 1)
plt.show()
PY
  echo

  echo "-- Issues --"
  echo "$issues" | jq -r '
    sort_by(.key)
    | .[] | "- \(.key): \(.hours)h — \(.status)\(if .done_date != "" then " (done \(.done_date))" else "" end) — \(.summary)"
  '
  echo

  local remaining done_hours
  remaining=$(echo "$series" | jq -r '[.[] | select(.actual != null)] | last | .actual // 0' | awk '{printf "%.2f", $1}')
  done_hours=$(awk -v t="$total_hours" -v r="$remaining" 'BEGIN{printf "%.2f", t - r}')
  echo "Total estimated: ${total_hours}h   Remaining: ${remaining}h   Done: ${done_hours}h"
}

cmd_release() {
  local project="${1:-${JIRA_PROJECT:-}}"
  : "${project:?Set JIRA_PROJECT or pass a project key: jira release <PROJECT>}"
  verify_auth

  local versions
  versions=$(api_get "$API/project/$project/versions")

  local unreleased
  unreleased=$(echo "$versions" | jq -c '
    [.[] | select((.archived // false) == false and (.released // false) == false)]
    | sort_by(.releaseDate // "9999-99-99")
  ')

  echo "Unreleased:"
  if [ "$(echo "$unreleased" | jq 'length')" -eq 0 ]; then
    echo "  none"
  else
    echo "$unreleased" | jq -r '
      .[] | "  - \(.name) (id \(.id), \(if .releaseDate then "release date: \(.releaseDate)" else "no release date set" end))\(if .description and .description != "" then " — \(.description)" else "" end)"
    '
  fi

  local last_released
  last_released=$(echo "$versions" | jq -c '
    [.[] | select((.archived // false) == false and (.released // false) == true)]
    | sort_by(.releaseDate // "")
    | last // empty
  ')
  if [ -z "$last_released" ] || [ "$last_released" = "null" ]; then
    echo "Last released: none found."
  else
    echo "$last_released" | jq -r '"Last released: \(.name) (\(.releaseDate // "no release date set"))"'
  fi
}

cmd_update() {
  local task_id="${1:-}" status="${2:-}"
  if [ -z "$task_id" ] || [ -z "$status" ]; then
    echo "Usage: jira update TASK_ID STATUS" >&2
    echo "STATUS is one of: todo, inprogress, review, done, closed" >&2
    exit 1
  fi

  local env_var transition_id
  case "$status" in
    todo)       env_var="JIRA_TRANSITION_TODO" ;;
    inprogress) env_var="JIRA_TRANSITION_INPROGRESS" ;;
    review)     env_var="JIRA_TRANSITION_REVIEW" ;;
    done)       env_var="JIRA_TRANSITION_DONE" ;;
    closed)     env_var="JIRA_TRANSITION_CLOSED" ;;
    *)
      echo "Unknown STATUS '$status'. Must be one of: todo, inprogress, review, done, closed" >&2
      exit 1
      ;;
  esac

  transition_id="${!env_var:-}"
  if [ -z "$transition_id" ]; then
    echo "Set $env_var to the transition id for '$status' (find via: GET $API/issue/$task_id/transitions)" >&2
    exit 1
  fi

  verify_auth
  api_post "$API/issue/$task_id/transitions" "{\"transition\":{\"id\":\"$transition_id\"}}" >/dev/null
  echo "$task_id -> $status (transition $transition_id)"
}

usage() {
  cat >&2 <<EOF
Usage: jira <command>

Commands:
  news     Lists my JIRA tasks (open, or in current sprint) as a markdown table.
  verify   jira verify [--sprint SPRINT_ID] - sprint/estimate hygiene + hour totals; picks active/future sprint via fzf.
  sprint   Prints the current and future sprints of JIRA_BOARD_ID.
  burndown jira burndown [--user EMAIL] [--sprint SPRINT_ID] - ASCII burndown chart (hours).
  release  Lists unreleased versions (and the last released one) of JIRA_PROJECT.
  update   jira update TASK_ID STATUS - transitions an issue (todo, inprogress, review, done, closed).
EOF
  exit 1
}

main() {
  local cmd="${1:-}"
  [ -z "$cmd" ] && usage
  shift || true
  case "$cmd" in
    news|verify|sprint|burndown|release|update) ;;
    *) usage ;;
  esac
  require_config "$cmd"
  "cmd_$cmd" "$@"
}

# Run only when executed, so tests can source this file.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
